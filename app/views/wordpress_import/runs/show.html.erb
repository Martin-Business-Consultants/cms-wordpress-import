<% @page_title = "Import from WordPress" %>

<%= render "layouts/shared/page_header", title: @page_title %>

<%# While it runs the page reloads itself (refresh), and stops once it's done. %>
<%= tag.div class: "stack stack--lg measure--lg", data: ({ controller: "refresh", refresh_interval_value: 3 } if @run.running?) do %>
  <section class="panel panel--padded stack">
    <div class="cluster">
      <h2 class="heading"><%= @run.filename %></h2>
      <%= status_tag @run.status %>
    </div>
    <% if @run.running? %>
      <p class="text-body">Importing. Images take the longest; this page checks every few seconds.</p>
    <% end %>
    <% if @run.counts.any? %>
      <dl class="wordpress-import-counts">
        <% @run.counts.each do |name, count| %>
          <%# herb:key name %>
          <div><dt><%= name.humanize %></dt><dd><%= count %></dd></div>
        <% end %>
      </dl>
    <% end %>
    <% if @run.lines.any? %>
      <pre class="<%= settings_code_classes("wordpress-import-log") %>"><code><%= @run.lines.join("\n") %></code></pre>
    <% end %>
  </section>

  <p><%= link_to "Import another file", wordpress_import_runs_path, class: "link" %></p>
<% end %>
