<% @page_title = "Import from WordPress" %>

<%= render "layouts/shared/page_header", title: @page_title,
      description: "Bring a WordPress site’s pages, posts and images over from its export file." %>

<div class="stack stack--lg measure--lg">
  <%= form_with url: wordpress_import_runs_path, multipart: true, class: "stack stack--lg" do |form| %>
    <section class="panel panel--padded stack">
      <div class="stack stack--xs">
        <h2 class="heading">The export file</h2>
        <p class="help">
          In WordPress, Tools › Export, “All content”, then Download Export File: an <code>.xml</code> file. Pages
          keep their hierarchy, posts become entries, and a page or post already here (by its slug) is updated.
        </p>
      </div>
      <%= form.file_field :file, accept: ".xml,application/xml,text/xml", required: true %>
    </section>

    <section class="panel panel--padded stack">
      <%= settings_field "Posts go into", hint: "A collection’s slug. One that doesn’t exist is made, with an excerpt, featured image, categories and tags." do %>
        <%= form.text_field :collection, value: "posts", list: "wordpress-import-collections", autocomplete: "off" %>
        <datalist id="wordpress-import-collections">
          <% @collections.each do |name, slug| %>
            <%# herb:key slug %>
            <option value="<%= slug %>"><%= name %></option>
          <% end %>
        </datalist>
      <% end %>
      <label class="choice choice--top">
        <%= form.check_box :media, {checked: true}, "1", "0" %>
        <span>Download the images and files into the media library (the <code>/wordpress</code> folder), and point the content at them.</span>
      </label>
      <label class="choice choice--top">
        <%= form.check_box :redirects, {checked: true}, "1", "0" %>
        <span>Redirect each old address that changes to the new one, so links and search results keep working.</span>
      </label>
      <label class="choice choice--top">
        <%= form.check_box :drafts, {checked: true}, "1", "0" %>
        <span>Bring drafts, pending and private pages and posts too, as drafts.</span>
      </label>
      <div><button type="submit" class="btn btn--primary">Import</button></div>
    </section>
  <% end %>

  <% if @runs.any? %>
    <section class="panel panel--padded stack stack--md">
      <h2 class="heading">Imports</h2>
      <ul class="divided">
        <% @runs.each do |run| %>
          <%# herb:key run.id %>
          <li class="wordpress-import-run">
            <%= link_to run.filename, wordpress_import_run_path(run), class: "title-link" %>
            <%= status_tag run.status %>
            <span class="text-small text-muted"><%= time_ago_tag run.created_at %><% if run.requested_by %> · <%= run.requested_by.email %><% end %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
